@{
    ViewData["Title"] = "Registration Successful";
}



<section class="success-page">


    <div class="success-box">


        <div class="success-icon">

            ✓

        </div>




        <h1>
            @(ViewBag.IsDeliveryApplication == true
                ? "Request sent to admin"
                : "Registration Successful!")
        </h1>




        <p>
            @if (ViewBag.IsDeliveryApplication == true)
            {
                <text>Your delivery partner request is pending. Please wait for admin approval before logging in.</text>
            }
            else
            {
                <text>Your GreenMart account has been created successfully.</text>
            }
        </p>




        <span>
            @(ViewBag.IsDeliveryApplication == true
                ? "We will email you when your account is approved."
                : "Redirecting you to login...")
        </span>



    </div>



</section>





<script>


    setTimeout(function() {

        window.location.href = "/Account/Login";


    }, @(ViewBag.IsDeliveryApplication == true ? 6500 : 3000));


</script>
