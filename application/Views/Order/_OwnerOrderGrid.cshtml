@model IEnumerable<GreenMart.DTOs.OrderProductSearchResultDto>
@using GreenMart.Models

@{
    var availableDeliveryMen = ViewBag.AvailableDeliveryMen as List<AvailableDeliveryManViewModel>
        ?? new List<AvailableDeliveryManViewModel>();
    var deliveryAssignments = ViewBag.OwnerDeliveryAssignments as Dictionary<int, DeliveryAssignment>
        ?? new Dictionary<int, DeliveryAssignment>();
    var defaultPickupAddress = ViewBag.SellerPickupAddress as string ?? string.Empty;
    var defaultPickupPhone = ViewBag.SellerPickupPhone as string ?? string.Empty;

    string DeliveryStatus(string status) => status switch
    {
        "GoingToPickup" => "Going to pickup",
        "ArrivedAtPickup" => "Arrived at seller",
        "PickedUp" => "Product picked up",
        "OnTheWay" => "On the way to customer",
        _ => status
    };
}


@if (Model == null || !Model.Any())
{

    <div class="empty-products">

        <div class="empty-products-icon">

            🛒

        </div>


        <h2>
            No Sales Found
        </h2>


        <p>

            @if (ViewBag.HasFilters == true)
            {
                @:No orders match your current search or filters.
            }
            else
            {
                @:No customers have ordered your products yet.
            }

        </p>


    </div>

}
else
{


    <div id="orderGrid"
         class="product-grid order-grid">



        @foreach(var product in Model)
        {

            var currentAssignment = deliveryAssignments.ContainsKey(product.OrderId)
                ? deliveryAssignments[product.OrderId]
                : null;


            <div class="product-card-custom order-card-custom">



                <div class="product-card-image">


                    @if(!string.IsNullOrEmpty(product.ImagePath))
                    {

                        <img src="@product.ImagePath"
                             alt="@product.ProductName"
                             loading="lazy" />

                    }
                    else
                    {

                        <div class="no-product-image">

                            🌱

                        </div>

                    }


                </div>




                <div class="product-category-tag">

                    @product.CategoryName

                </div>




                <h2>

                    @product.ProductName

                </h2>




                <p class="product-brand-text">

                    Brand:

                    @(string.IsNullOrEmpty(product.Brand)
                        ? "Not specified"
                        : product.Brand)

                </p>





                <p class="product-description-text">

                    @(string.IsNullOrEmpty(product.Description)
                        ? "No description available."
                        : product.Description)

                </p>





                <div class="product-info-box">


                    <span>

                        Quantity:

                        @product.Quantity

                    </span>



                    <span>

                        Price:

                        ৳@(product.Price * product.Quantity)

                    </span>


                </div>





                <div class="product-seller-text">

                    Buyer:

                    @product.BuyerName


                    <br />


                    Email:

                    @product.BuyerEmail


                    <br />


                    Phone:

                    @product.BuyerPhone


                </div>




                <div class="product-seller-text">

                    Address:

                    @(string.IsNullOrEmpty(product.BuyerAddress)
                        ? "Not provided"
                        : product.BuyerAddress)

                </div>




                <div class="product-seller-text">


                    Order Date:

                    @product.OrderDate.ToString("dd MMM yyyy")


                    <br />


                    Status:

                    @product.OrderStatus


                </div>



                @if(product.OrderStatus == "Rejected")
                {

                    <div class="product-seller-text">


                        Rejection Reason:

                        @(string.IsNullOrEmpty(product.RejectionReason)
                            ? "Not specified"
                            : product.RejectionReason)


                        <br />


                        Additional Note:

                        @(string.IsNullOrEmpty(product.RejectionNote)
                            ? "No additional note provided."
                            : product.RejectionNote)


                    </div>

                }




                @if(product.OrderStatus == "Pending")
                {

                    <div class="order-action-buttons">


                        <button class="order-confirm-btn"
                                data-order-id="@product.OrderId">

                            Confirm Order

                        </button>



                        <button class="order-reject-btn"
                                data-order-id="@product.OrderId">

                            Reject Order

                        </button>


                    </div>

                }

                @if (product.OrderStatus == "Confirmed" || currentAssignment != null)
                {
                    <div class="delivery-assignment-panel">
                        <span class="delivery-panel-label">Delivery partner</span>

                        @if (currentAssignment != null)
                        {
                            <div class="assigned-delivery-person">
                                <strong>@currentAssignment.DeliveryMan.FullName</strong>
                                <span>@DeliveryStatus(currentAssignment.Status)</span>
                            </div>
                            <div class="seller-pickup-summary">
                                <span>Pickup from</span>
                                <strong>@currentAssignment.PickupAddress</strong>
                                <small>@currentAssignment.PickupPhone</small>
                            </div>
                            <a asp-controller="Delivery"
                               asp-action="Track"
                               asp-route-assignmentId="@currentAssignment.DeliveryAssignmentId"
                               class="track-delivery-link">
                                Track delivery partner
                            </a>
                        }

                        @if (currentAssignment == null || currentAssignment.Status == "Assigned")
                        {
                            @if (availableDeliveryMen.Any())
                            {
                                <form asp-controller="Delivery" asp-action="Assign" method="post" class="delivery-assign-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderId" value="@product.OrderId" />
                                    <select name="deliveryManId" required aria-label="Choose an available delivery partner">
                                        <option value="">Choose available partner</option>
                                        @foreach (var deliveryMan in availableDeliveryMen)
                                        {
                                            <option value="@deliveryMan.UserId">
                                                @deliveryMan.FullName · @deliveryMan.VehicleType · @(deliveryMan.RatingCount == 0 ? "New" : $"★ {deliveryMan.AverageRating:F1}")
                                            </option>
                                        }
                                    </select>

                                    <div class="pickup-form-fields">
                                        <div class="pickup-address-field">
                                            <label>
                                                Pickup address
                                                <textarea name="pickupAddress"
                                                          id="pickupAddress-@product.OrderId"
                                                          maxlength="300" required
                                                          placeholder="Where should the delivery partner collect the product?">@(currentAssignment?.PickupAddress ?? defaultPickupAddress)</textarea>
                                            </label>
                                            <input type="hidden" name="pickupLatitude" id="pickupLatitude-@product.OrderId" value="@currentAssignment?.PickupLatitude" />
                                            <input type="hidden" name="pickupLongitude" id="pickupLongitude-@product.OrderId" value="@currentAssignment?.PickupLongitude" />
                                            <button type="button"
                                                    class="location-picker-trigger js-location-picker"
                                                    data-address-target="#pickupAddress-@product.OrderId"
                                                    data-latitude-target="#pickupLatitude-@product.OrderId"
                                                    data-longitude-target="#pickupLongitude-@product.OrderId"
                                                    data-picker-title="Choose seller pickup location">
                                                Set exact location on map
                                            </button>
                                        </div>
                                        <label>
                                            Pickup phone
                                            <input type="tel" name="pickupPhone" maxlength="20" required
                                                   value="@(currentAssignment?.PickupPhone ?? defaultPickupPhone)"
                                                   placeholder="Seller contact number" />
                                        </label>
                                        <label>
                                            Pickup instructions <small>(optional)</small>
                                            <textarea name="pickupInstructions" maxlength="500"
                                                      placeholder="Example: Call at the gate or collect from apartment 4B">@currentAssignment?.PickupInstructions</textarea>
                                        </label>
                                    </div>
                                    <button type="submit">@(currentAssignment == null ? "Assign" : "Reassign")</button>
                                </form>
                            }
                            else if (currentAssignment == null)
                            {
                                <p class="delivery-help-text">No delivery partners are available right now.</p>
                            }
                        }
                    </div>
                }


            </div>


        }


    </div>


}
