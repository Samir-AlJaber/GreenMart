@model IEnumerable<GreenMart.DTOs.ProductSearchResultDto>


@if (Model == null || !Model.Any())
{

    <div class="empty-products">

        <div class="empty-products-icon">
            🛒
        </div>


        <h2>
            No Products Found
        </h2>


        <p>
            No products match your current search or filters.
        </p>

    </div>

}
else
{

    <div id="productGrid"
         class="product-grid">


        @foreach (var product in Model)
        {

            <div class="product-card-custom"
                 data-category="@product.CategoryName">


                <div class="product-card-image">

                    @if (!string.IsNullOrEmpty(product.ImagePath))
                    {
                        <img src="@product.ImagePath"
                             alt="@product.ProductName"
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="no-product-image">
                            🌱
                        </div>
                    }

                </div>



                <div class="product-category-tag">

                    @product.CategoryName

                </div>



                <h2>

                    @product.ProductName

                </h2>



                <p class="product-brand-text">

                    Brand:
                    @(string.IsNullOrEmpty(product.Brand)
                        ? "Not specified"
                        : product.Brand)

                </p>



                <p class="product-description-text">

                    @(string.IsNullOrEmpty(product.Description)
                        ? "No description available."
                        : product.Description)

                </p>



                <div class="product-info-box">

                    <span>
                        Price:
                        ৳@product.Price
                    </span>


                    <span>
                        Stock:
                        @product.StockQuantity
                    </span>

                </div>



                <div class="product-seller-text">

                    Seller:
                    @product.SellerName

                </div>



                <a asp-controller="Product"
                   asp-action="Details"
                   asp-route-id="@product.ProductId"
                   class="product-details-btn">

                    View Details

                </a>


            </div>

        }


    </div>

}