@model GreenMart.Models.Product

@{
    ViewData["Title"] = "Add Product";
}



<section class="product-form-page">


    <div class="product-form-card">


        <div class="product-form-header">

            <h1>
                Add New Product
            </h1>


            <p>
                Create your product listing on GreenMart.
            </p>

        </div>


        <form asp-controller="Product"
              asp-action="Create"
              method="post"
              id="productForm">



            <div class="product-input-group">


                <label>
                    Product Name
                </label>



                <input asp-for="ProductName"
                       id="ProductName"
                       placeholder="Enter product name" />


                <span id="productNameError"
                      class="client-error">
                </span>


            </div>


            <div class="product-input-group">


                <label>
                    Brand (Optional)
                </label>



                <input asp-for="Brand"
                       placeholder="Enter brand name" />


            </div>



            <div class="product-input-group">


                <label>
                    Category
                </label>



                <select asp-for="CategoryId"
                        id="CategoryId"
                        class="product-select">


                    <option value="">
                        Select Category
                    </option>



                    @foreach (var category in ViewBag.Categories)
                    {

                        <option value="@category.CategoryId">

                            @category.CategoryName

                        </option>

                    }


                </select>


                <span id="categoryError"
                      class="client-error">
                </span>


            </div>


            <div class="product-input-group">


                <label>
                    Description
                </label>



                <textarea asp-for="Description"
                          id="Description"
                          placeholder="Describe your product">
                </textarea>



                <div class="description-counter">

                    <span id="descriptionCount">
                        0
                    </span>

                    /100 characters

                </div>



                <span id="descriptionError"
                      class="client-error">
                </span>


            </div>


            <div class="product-form-row">



                <div class="product-input-group">


                    <label>
                        Price
                    </label>



                    <input asp-for="Price"
                           id="Price"
                           type="number"
                           step="0.01"
                           placeholder="Enter price" />



                    <span id="priceError"
                          class="client-error">
                    </span>


                </div>







                <div class="product-input-group">


                    <label>
                        Stock Quantity
                    </label>



                    <input asp-for="StockQuantity"
                           id="StockQuantity"
                           type="number"
                           placeholder="Enter quantity" />



                    <span id="stockError"
                          class="client-error">
                    </span>


                </div>



            </div>







            <button type="submit"
                    class="product-submit-btn">

                Add Product

            </button>



        </form>


    </div>


</section>








<script>


const productName =
    document.getElementById("ProductName");


const category =
    document.getElementById("CategoryId");


const price =
    document.getElementById("Price");


const stock =
    document.getElementById("StockQuantity");


const description =
    document.getElementById("Description");


const descriptionCount =
    document.getElementById("descriptionCount");






description.addEventListener(
    "input",
    function(){


        let length =
            this.value.length;



        descriptionCount.innerHTML =
            length;



        if(length > 100)
        {

            document
            .getElementById("descriptionError")
            .innerHTML =
            "Description cannot be more than 100 characters";



            this.classList.add(
                "input-error-border"
            );


            descriptionCount.style.color =
                "#dc2626";


        }
        else
        {


            document
            .getElementById("descriptionError")
            .innerHTML =
            "";



            this.classList.remove(
                "input-error-border"
            );


            descriptionCount.style.color =
                "#64748b";


        }


    }
);







productName.addEventListener(
    "input",
    function(){

        if(this.value.trim() !== "")
        {

            document
            .getElementById("productNameError")
            .innerHTML = "";


            this.classList.remove(
                "input-error-border"
            );

        }

    }
);








category.addEventListener(
    "change",
    function(){

        if(this.value !== "")
        {

            document
            .getElementById("categoryError")
            .innerHTML = "";


            this.classList.remove(
                "input-error-border"
            );

        }

    }
);








price.addEventListener(
    "input",
    function(){

        if(this.value !== "" &&
           Number(this.value) > 0)
        {

            document
            .getElementById("priceError")
            .innerHTML = "";


            this.classList.remove(
                "input-error-border"
            );

        }

    }
);








stock.addEventListener(
    "input",
    function(){

        if(this.value !== "" &&
           Number(this.value) > 0)
        {

            document
            .getElementById("stockError")
            .innerHTML = "";


            this.classList.remove(
                "input-error-border"
            );

        }

    }
);









document
.getElementById("productForm")
.addEventListener(
"submit",
function(e){


    let valid = true;





    if(productName.value.trim() === "")
    {

        document
        .getElementById("productNameError")
        .innerHTML =
        "Product name is required";


        productName.classList.add(
            "input-error-border"
        );


        valid = false;

    }






    if(category.value === "")
    {

        document
        .getElementById("categoryError")
        .innerHTML =
        "Please select a category";


        category.classList.add(
            "input-error-border"
        );


        valid = false;

    }







    if(price.value === "" ||
       Number(price.value) <= 0)
    {

        document
        .getElementById("priceError")
        .innerHTML =
        "Price is required";


        price.classList.add(
            "input-error-border"
        );


        valid = false;

    }







    if(stock.value === "" ||
       Number(stock.value) <= 0)
    {

        document
        .getElementById("stockError")
        .innerHTML =
        "Stock quantity is required";


        stock.classList.add(
            "input-error-border"
        );


        valid = false;

    }







    if(description.value.length > 100)
    {

        document
        .getElementById("descriptionError")
        .innerHTML =
        "Description cannot be more than 100 characters";


        description.classList.add(
            "input-error-border"
        );


        valid = false;

    }







    if(!valid)
    {
        e.preventDefault();
    }



});


</script>





@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}