@model IEnumerable<GreenMart.Models.Product>

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    ViewData["Title"] = "My Products";
}



<section class="my-products-page">


    <div class="my-products-header">


        <h1>
            My Products
        </h1>


        <p>
            Manage the products you have listed on GreenMart.
        </p>



        <a asp-controller="Product"
           asp-action="Create"
           class="my-product-add-btn">

            Add New Product

        </a>


    </div>



    <div class="product-search-area listing-search"
         data-suggestions-url="@Url.Action("MyProductSuggestions", "Product")"
         data-results-url="@Url.Action("MyProductSearchResults", "Product")"
         data-grid-target="#myProductListingResults"
         data-item-url="/Product/Edit/"
         data-sort-target=".listing-sort"
         data-category-target=".filter-category"
         data-brand-target=".filter-brand"
         data-min-price-target=".filter-min-price"
         data-max-price-target=".filter-max-price"
         data-stock-target=".filter-stock"
         data-reset-target=".filter-reset">


        <input type="text"
           id="myProductSearchBox"
           class="listing-search-input"
           placeholder="Search your products..."
           autocomplete="off" />


        <div id="myProductSearchSuggestions"
             class="search-suggestions listing-search-suggestions">
        </div>


    </div>
                        <div class="listing-filters">


                        <div class="filter-group">

                            <label>
                                Category
                            </label>


                            <select class="filter-category">

                                <option value="">
                                    All Categories
                                </option>


                                @foreach (var category in ViewBag.Categories ?? new List<GreenMart.Models.Category>())
                                {

                                    <option value="@category.CategoryId">

                                        @category.CategoryName

                                    </option>

                                }

                            </select>

                        </div>



                        <div class="filter-group">

                            <label>
                                Brand
                            </label>


                            <select class="filter-brand">

                                <option value="">
                                    All Brands
                                </option>


                                @foreach (var brand in ViewBag.Brands ?? new List<string>())
                                {

                                    <option value="@(brand == "Not specified" ? "__NONE__" : brand)">

                                        @brand

                                    </option>

                                }

                            </select>

                        </div>



                        <div class="filter-group">

                            <label>
                                Min Price
                            </label>


                            <input type="number"
                                   class="filter-min-price"
                                   placeholder="Min" />

                        </div>




                        <div class="filter-group">

                            <label>
                                Max Price
                            </label>


                            <input type="number"
                                   class="filter-max-price"
                                   placeholder="Max" />

                        </div>




                        <div class="filter-group">

                            <label>
                                Availability
                            </label>


                            <select class="filter-stock">

                                <option value="">
                                    All Products
                                </option>


                                <option value="true">
                                    In Stock
                                </option>


                                <option value="false">
                                    Out of Stock
                                </option>


                            </select>

                        </div>




                        <button type="button"
                                class="filter-reset">

                            Reset

                        </button>


                    </div>

                <div class="listing-controls">

                    <label>
                        Sort:
                    </label>


                    <select class="listing-sort">

                        <option value="">
                            Newest
                        </option>


                        <option value="oldest">
                            Oldest
                        </option>


                        <option value="price_low">
                            Price Low → High
                        </option>


                        <option value="price_high">
                            Price High → Low
                        </option>


                        <option value="name_az">
                            Name A → Z
                        </option>


                        <option value="name_za">
                            Name Z → A
                        </option>


                    </select>

                </div>

    @if (!Model.Any())
    {


        <div class="my-products-empty">


            <h2>
                No Products Found
            </h2>



            <p>
                You have not added any products yet.
            </p>




            <a asp-controller="Product"
               asp-action="Create">

                Create Your First Product

            </a>


        </div>


    }

    else
    {
        <div id="myProductListingResults">

            <partial name="_MyProductGrid"
                     model="Model" />

        </div>

    }

</section>







<div class="delete-overlay"
     id="deletePopup">


    <div class="delete-box">


        <div class="delete-icon">

            ⚠️

        </div>


        <h3>
            Delete Product?
        </h3>


        <p>
            Are you sure you want to remove this product from your listings?
        </p>



        <div class="delete-buttons">


            <button type="button"
                    onclick="hideDeletePopup()"
                    class="delete-cancel">

                Cancel

            </button>




            <form asp-controller="Product"
                  asp-action="Delete"
                  method="post">


                <input type="hidden"
                       id="deleteProductId"
                       name="id" />



                <button type="submit"
                        class="delete-confirm">

                    Confirm Delete

                </button>


            </form>


        </div>


    </div>


</div>


@section Scripts {

    <script src="~/js/listing-search.js"></script>


    <script>

        function showDeletePopup(id) {

            document
                .getElementById("deleteProductId")
                .value = id;


            document
                .getElementById("deletePopup")
                .style.display = "flex";

        }


        function hideDeletePopup() {

            document
                .getElementById("deletePopup")
                .style.display = "none";

        }

    </script>

}
