@model IEnumerable<GreenMart.Models.Product>

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    ViewData["Title"] = "My Products";
}



<section class="my-products-page">


    <div class="my-products-header">


        <h1>
            My Products
        </h1>


        <p>
            Manage the products you have listed on GreenMart.
        </p>



        <a asp-controller="Product"
           asp-action="Create"
           class="my-product-add-btn">

            Add New Product

        </a>


    </div>







    @if (!Model.Any())
    {


        <div class="my-products-empty">


            <h2>
                No Products Found
            </h2>



            <p>
                You have not added any products yet.
            </p>




            <a asp-controller="Product"
               asp-action="Create">

                Create Your First Product

            </a>


        </div>


    }
    else
    {



        <div class="my-products-grid">



            @foreach (var product in Model)
            {

                var productImageDirectory = System.IO.Path.Combine(
                    WebHostEnvironment.WebRootPath,
                    "uploads",
                    "products"
                );

                var productImagePaths =
                    System.IO.Directory.Exists(productImageDirectory)
                        ? System.IO.Directory.GetFiles(
                            productImageDirectory,
                            $"product-{product.ProductId}-*.png"
                        ).OrderBy(path => path).ToList()
                        : new List<string>();

                var legacyImagePath = System.IO.Path.Combine(
                    productImageDirectory,
                    $"product-{product.ProductId}.png"
                );

                if (productImagePaths.Count == 0 &&
                    System.IO.File.Exists(legacyImagePath))
                {
                    productImagePaths.Add(legacyImagePath);
                }

                var imageFileName = productImagePaths.Count > 0
                    ? System.IO.Path.GetFileName(productImagePaths[0])
                    : null;

                var hasProductImage = imageFileName != null;


                <div class="my-product-card">

                    @if (hasProductImage)
                    {
                        <div class="my-product-image">
                            <img src="~/uploads/products/@imageFileName"
                                 alt="@product.ProductName"
                                 loading="lazy" />

                            @if (productImagePaths.Count > 1)
                            {
                                <span class="product-card-photo-count">
                                    @productImagePaths.Count photos
                                </span>
                            }
                        </div>
                    }



                    <div class="my-product-category">


                        @product.Category.CategoryName


                    </div>






                    <h2>

                        @product.ProductName

                    </h2>

                    <p class="my-product-brand">

                        Brand:
                        @(string.IsNullOrEmpty(product.Brand)
                            ? "Not specified"
                            : product.Brand)

                    </p>


                    <p>

                        Price:
                        ৳@product.Price

                    </p>






                    <p>

                        Stock:
                        @product.StockQuantity

                    </p>






                    <p>

                        Status:

                        @(product.IsActive
                            ? "Active"
                            : "Inactive")

                    </p>








                    <div class="my-product-actions">





                        <a asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@product.ProductId">

                            View

                        </a>







                        <a asp-controller="Product"
                           asp-action="Edit"
                           asp-route-id="@product.ProductId">

                            Edit

                        </a>







                        <button type="button"
                                onclick="showDeletePopup(@product.ProductId)"
                                class="product-delete-btn">

                            Delete

                        </button>





                    </div>



                </div>


            }



        </div>


    }



</section>







<div class="delete-overlay"
     id="deletePopup">


    <div class="delete-box">


        <div class="delete-icon">

            ⚠️

        </div>


        <h3>
            Delete Product?
        </h3>


        <p>
            Are you sure you want to remove this product from your listings?
        </p>



        <div class="delete-buttons">


            <button type="button"
                    onclick="hideDeletePopup()"
                    class="delete-cancel">

                Cancel

            </button>




            <form asp-controller="Product"
                  asp-action="Delete"
                  method="post">


                <input type="hidden"
                       id="deleteProductId"
                       name="id" />



                <button type="submit"
                        class="delete-confirm">

                    Confirm Delete

                </button>


            </form>


        </div>


    </div>


</div>


<script>


    function showDeletePopup(id) {

        document
            .getElementById("deleteProductId")
            .value = id;



        document
            .getElementById("deletePopup")
            .style.display = "flex";

    }





    function hideDeletePopup() {

        document
            .getElementById("deletePopup")
            .style.display = "none";

    }


</script>
