@model GreenMart.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}



<section class="product-form-page">


    <div class="product-form-card">


        <div class="product-form-header">


            <h1>
                Edit Product
            </h1>



            <p>
                Update your product information.
            </p>


        </div>






        <form asp-controller="Product"
              asp-action="Edit"
              method="post">


            <input type="hidden"
                   asp-for="ProductId" />




            <div asp-validation-summary="ModelOnly"
                 class="product-form-error">
            </div>






            <div class="product-input-group">


                <label>
                    Product Name
                </label>



                <input asp-for="ProductName"
                       placeholder="Enter product name" />



                <span asp-validation-for="ProductName"
                      class="product-input-error">
                </span>


            </div>








            <div class="product-input-group">


                <label>
                    Brand (Optional)
                </label>



                <input asp-for="Brand"
                       placeholder="Enter brand name" />


            </div>








            <div class="product-input-group">


                <label>
                    Category
                </label>




                <select asp-for="CategoryId"
                        class="product-select">


                    <option value="">
                        Select Category
                    </option>




                    @foreach (var category in ViewBag.Categories)
                    {

                        <option value="@category.CategoryId">

                            @category.CategoryName

                        </option>

                    }



                </select>


            </div>








            <div class="product-input-group">


                <label>
                    Description
                </label>



                <textarea asp-for="Description"
                          placeholder="Describe your product">
                </textarea>


            </div>








            <div class="product-form-row">



                <div class="product-input-group">


                    <label>
                        Price
                    </label>



                    <input asp-for="Price"
                           type="number"
                           step="0.01" />


                </div>







                <div class="product-input-group">


                    <label>
                        Stock Quantity
                    </label>



                    <input asp-for="StockQuantity"
                           type="number" />


                </div>



            </div>








            <button type="submit"
                    class="product-submit-btn">

                Save Changes

            </button>




        </form>


    </div>


</section>





@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}