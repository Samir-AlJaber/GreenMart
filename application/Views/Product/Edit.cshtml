@model GreenMart.Models.Product

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    ViewData["Title"] = "Edit Product";

    var productImageDirectory = System.IO.Path.Combine(
        WebHostEnvironment.WebRootPath,
        "uploads",
        "products"
    );

    var existingImagePaths =
        System.IO.Directory.Exists(productImageDirectory)
            ? System.IO.Directory.GetFiles(
                productImageDirectory,
                $"product-{Model.ProductId}-*.png"
            ).OrderBy(path => path).ToList()
            : new List<string>();

    var legacyImagePath = System.IO.Path.Combine(
        productImageDirectory,
        $"product-{Model.ProductId}.png"
    );

    if (existingImagePaths.Count == 0 &&
        System.IO.File.Exists(legacyImagePath))
    {
        existingImagePaths.Add(legacyImagePath);
    }

    var existingImageNames = existingImagePaths
        .Select(System.IO.Path.GetFileName)
        .Where(fileName => fileName != null)
        .Cast<string>()
        .ToList();
}

<section class="product-form-page">

    <div class="product-form-card">

        <div class="product-form-header">

            <h1>Edit Product</h1>

            <p>Update your product information and photos.</p>

        </div>

        <form asp-controller="Product"
              asp-action="Edit"
              method="post"
              enctype="multipart/form-data"
              id="productForm">

            <input type="hidden"
                   asp-for="ProductId" />

            <div asp-validation-summary="ModelOnly"
                 class="product-form-error">
            </div>

            <div class="product-input-group">

                <label>Product Name</label>

                <input asp-for="ProductName"
                       placeholder="Enter product name" />

                <span asp-validation-for="ProductName"
                      class="product-input-error">
                </span>

            </div>

            <div class="product-input-group">

                <label>Brand (Optional)</label>

                <input asp-for="Brand"
                       placeholder="Enter brand name" />

            </div>

            <div class="product-input-group">

                <label>Category</label>

                <select asp-for="CategoryId"
                        class="product-select">

                    <option value="">Select Category</option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.CategoryId">
                            @category.CategoryName
                        </option>
                    }

                </select>

            </div>

            <div class="product-input-group">

                <label>Description</label>

                <textarea asp-for="Description"
                          placeholder="Describe your product">
                </textarea>

            </div>

            <div class="product-form-row">

                <div class="product-input-group">

                    <label>Price</label>

                    <input asp-for="Price"
                           type="number"
                           step="0.01" />

                </div>

                <div class="product-input-group">

                    <label>Stock Quantity</label>

                    <input asp-for="StockQuantity"
                           type="number" />

                </div>

            </div>

            <div class="product-input-group product-image-upload">

                <label for="ProductImageSource">
                    Product Photos (Optional)
                </label>

                @if (existingImageNames.Count > 0)
                {
                    <div class="product-existing-photos">

                        <div class="product-existing-photos-heading">
                            <strong>Current photos</strong>
                            <span>Selecting new photos will replace this set.</span>
                        </div>

                        <div class="product-existing-photos-grid">
                            @for (var index = 0;
                                  index < existingImageNames.Count;
                                  index++)
                            {
                                <div class="product-existing-photo">
                                    <img src="~/uploads/products/@existingImageNames[index]"
                                         alt="Current @Model.ProductName photo @(index + 1)" />

                                    <span>
                                        @(index == 0 ? "Main photo" : $"Photo {index + 1}")
                                    </span>
                                </div>
                            }
                        </div>

                    </div>
                }

                <label class="product-image-dropzone"
                       id="productImageDropzone"
                       for="ProductImageSource">

                    <span class="product-image-upload-mark"
                          aria-hidden="true">
                        <svg viewBox="0 0 24 24"
                             focusable="false">
                            <path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h2.1l1-1.5h4.8l1 1.5h2.1A2.5 2.5 0 0 1 20 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5v-9Z" />
                            <circle cx="12" cy="12" r="3.2" />
                        </svg>
                    </span>

                    <span class="product-image-upload-copy">
                        <strong>Browse new product photos</strong>
                        <small>Choose up to 8 from your phone or laptop · JPG, PNG or WebP</small>
                        <small class="product-image-auto-note">Leave this empty to keep the current photos.</small>
                    </span>

                    <span class="product-image-browse">Browse</span>

                    <input type="file"
                           id="ProductImageSource"
                           multiple
                           accept="image/png,image/jpeg,image/webp" />

                </label>

                <label class="product-background-option"
                       for="AutoRemoveProductBackground">

                    <input type="checkbox"
                           id="AutoRemoveProductBackground" />

                    <span>
                        <strong>Remove background automatically</strong>
                        <small>Optional — works best with a plain, contrasting background.</small>
                    </span>

                </label>

                <input type="file"
                       id="ProductImages"
                       name="ProductImages"
                       multiple
                       accept="image/png"
                       hidden />

                <div class="product-image-preview-shell"
                     id="productImagePreviewShell">

                    <div id="productImagePreviewGrid"
                         class="product-image-preview-grid">
                    </div>

                    <button type="button"
                            id="removeProductImage"
                            class="product-image-remove">
                        Keep current photos
                    </button>

                </div>

                <p id="productImageStatus"
                   class="product-image-status"
                   aria-live="polite">
                    Browse only if you want to replace the current product photos.
                </p>

                @Html.ValidationMessage(
                    "ProductImages",
                    null,
                    new { @class = "product-input-error" }
                )

            </div>

            <button type="submit"
                    class="product-submit-btn"
                    id="productSubmitButton">
                Save Changes
            </button>

        </form>

    </div>

</section>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/product-image-editor.js" asp-append-version="true"></script>
    <script src="~/js/product-image-uploader.js" asp-append-version="true"></script>

}
