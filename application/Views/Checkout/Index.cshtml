@model GreenMart.Models.Cart

@{
    ViewData["Title"] = "Checkout";
}



<section class="checkout-page">


    <div class="checkout-header">

        <h1>
            Checkout
        </h1>

        <p>
            Complete your order details before placing your order.
        </p>

    </div>



    <div class="checkout-container">


        <div class="checkout-details">


            <h2>
                Delivery Information
            </h2>


            <div class="checkout-field">

                <label>
                    Full Name
                </label>

                <input type="text"
                       value="@Model.User.FullName"
                       readonly />

            </div>



            <div class="checkout-field">

                <label>
                    Phone Number
                </label>

                <input type="text"
                   name="PhoneNumber"
                   id="phoneNumber"
                   value="@Model.User.PhoneNumber"
                   maxlength="11"
                   inputmode="numeric"
                   autocomplete="tel"
                   required />

                   <p id="phoneError"
                       class="checkout-error">
                    </p>

            </div>



            <div class="checkout-field">

                <label>
                    Shipping Address
                </label>

                <textarea name="ShippingAddress"
                          id="shippingAddress"
                          rows="4"
                          required>@Model.User.Address</textarea>

                <input type="hidden" name="ShippingLatitude" id="shippingLatitude" />
                <input type="hidden" name="ShippingLongitude" id="shippingLongitude" />

                <button type="button"
                        class="location-picker-trigger js-location-picker"
                        data-address-target="#shippingAddress"
                        data-latitude-target="#shippingLatitude"
                        data-longitude-target="#shippingLongitude"
                        data-picker-title="Choose delivery location">
                    Set exact location on map
                </button>

                         <p id="addressError"
                           class="checkout-error">
                        </p>

            </div>



        </div>




        <div class="checkout-summary">


            <h2>
                Order Summary
            </h2>



            @foreach (var item in Model.CartItems)
            {


                <div class="checkout-product">


                    <span>
                        @item.Product.ProductName
                        ×
                        @item.Quantity
                    </span>


                    <strong>
                        ৳@(item.Product.Price * item.Quantity)
                    </strong>


                </div>


            }



            <div class="checkout-total">


                <span>
                    Total
                </span>


                <strong>

                    ৳@Model.CartItems.Sum(
                        x =>
                        x.Product.Price *
                        x.Quantity
                    )

                </strong>


            </div>



            <button type="button"
                    id="placeOrderBtn"
                    class="place-order-btn">

                Place Order

            </button>



        </div>


    </div>


</section>

<div class="order-place-overlay"
     id="placeOrderOverlay"
     style="display:none;">


    <div class="order-place-box">


        <h3>
            Confirm Order
        </h3>


        <p>
            Are you sure you want to place this order?
        </p>



        <div class="order-place-buttons">


            <button type="button"
                    id="cancelPlaceOrder">

                Cancel

            </button>



            <button type="button"
                    id="confirmPlaceOrder">

                Confirm Order

            </button>


        </div>


    </div>


</div>

<partial name="_LocationPicker" />



<div class="order-success-message"
     id="orderSuccessMessage"
     style="display:none;">

    <strong>Order placed successfully</strong>
    <span>Your PDF receipt is ready to save or show to the delivery partner.</span>
    <div class="order-success-actions">
        <a id="downloadOrderReceipt" href="#">Download PDF receipt</a>
        <a asp-controller="Order" asp-action="MyOrders" class="success-orders-link">View My Orders</a>
    </div>

</div>

<script>

            document
            .getElementById("phoneNumber")
            .addEventListener(
                "input",
                function ()
                {

                    this.value =
                        this.value.replace(
                            /[^0-9]/g,
                            ""
                        );

                }
            );

</script>

<script>

                document
                .getElementById("placeOrderBtn")
                .addEventListener(
                    "click",
                    function ()
                    {


                        let phone =
                            document
                            .getElementById("phoneNumber")
                            .value;


                        let address =
                            document
                            .querySelector(
                                "textarea[name='ShippingAddress']"
                            )
                            .value;

                        let latitude = document.getElementById("shippingLatitude").value;
                        let longitude = document.getElementById("shippingLongitude").value;



                        document
                            .getElementById("phoneError")
                            .innerHTML = "";

                            document
                            .getElementById("phoneError")
                            .classList.remove("show");


                            document
                            .getElementById("addressError")
                            .innerHTML = "";

                            document
                            .getElementById("addressError")
                            .classList.remove("show");


                        fetch(
                              "/Checkout/ValidateOrder",
                            {

                                method: "POST",

                                headers:
                                {
                                    "Content-Type":
                                    "application/x-www-form-urlencoded"
                                },


                                body:
                                `PhoneNumber=${encodeURIComponent(phone)}&ShippingAddress=${encodeURIComponent(address)}&ShippingLatitude=${encodeURIComponent(latitude)}&ShippingLongitude=${encodeURIComponent(longitude)}`

                            }
                        )

                        .then(
                            response =>
                            response.json()
                        )


                        .then(
                            data =>
                            {


                                if(data.success)
                                {

                                    document
                                    .getElementById("placeOrderOverlay")
                                    .style.display = "flex";


                                }
                                else
                                {


                                    if(data.phoneError)
{

                                        document
                                        .getElementById("phoneError")
                                        .innerHTML =
                                        data.phoneError;


                                        document
                                        .getElementById("phoneError")
                                        .classList.add("show");

                                    }



                                    if(data.addressError)
                                    {

                                        document
                                        .getElementById("addressError")
                                        .innerHTML =
                                        data.addressError;


                                        document
                                        .getElementById("addressError")
                                        .classList.add("show");

                                    }


                                }


                            }
                        );


                    }

                );

</script>

<script>
                                document
                                    .getElementById("cancelPlaceOrder")
                                    .addEventListener(
                                        "click",
                                        function()
                                        {

                                            document
                                            .getElementById("placeOrderOverlay")
                                            .style.display = "none";

                                        }
                                    );



                                    document
.getElementById("confirmPlaceOrder")
.addEventListener(
    "click",
    function()
    {

        let phone =
            document
            .getElementById("phoneNumber")
            .value;


        let address =
            document
            .querySelector(
                "textarea[name='ShippingAddress']"
            )
            .value;

        let latitude = document.getElementById("shippingLatitude").value;
        let longitude = document.getElementById("shippingLongitude").value;



        fetch(
            "/Checkout/PlaceOrder",
            {

                method: "POST",

                headers:
                {
                    "Content-Type":
                    "application/x-www-form-urlencoded"
                },


                body:
                `PhoneNumber=${encodeURIComponent(phone)}&ShippingAddress=${encodeURIComponent(address)}&ShippingLatitude=${encodeURIComponent(latitude)}&ShippingLongitude=${encodeURIComponent(longitude)}`

            }
        )

        .then(
            response =>
            response.json()
        )


        .then(
            data =>
            {

                if(data.success)
                {

                    document
                    .getElementById("placeOrderOverlay")
                    .style.display = "none";



                    document
                    .getElementById("orderSuccessMessage")
                    .style.display = "grid";

                    document
                    .getElementById("downloadOrderReceipt")
                    .href =
                    `/Order/DownloadReceipt?orderId=${data.orderId}`;

                    fetch("/Cart/CartCount")
                        .then(response => response.json())
                        .then(data =>
                    {

                        let badge =
                            document.getElementById("cartCountBadge");


                        if(badge)
                        {
                            badge.innerHTML = data.count;
                        }

                    });

                }


            }

        );


    }
);

</script>
